generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum TranslationStatus {
  DRAFT
  MACHINE_TRANSLATED
  REVIEWED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  mediaAssets  MediaAsset[]
}

model SiteSetting {
  id                     Int      @id @default(1)
  companyNameZh          String
  companyNameEn          String
  phone                  String
  fax                    String?
  email                  String
  addressZh              String
  addressEn              String
  icpRecord              String
  copyrightZh            String
  copyrightEn            String
  logoUrl                String?
  footerBuilderZh        String?
  footerBuilderEn        String?
  homeHeroTitleZh        String?
  homeHeroTitleEn        String?
  homeHeroSubtitleZh     String?
  homeHeroSubtitleEn     String?
  homeHeroImageUrl       String?
  homeProductSectionTitleZh    String?
  homeProductSectionTitleEn    String?
  homeProductSectionSubtitleZh String?
  homeProductSectionSubtitleEn String?
  homeSolutionSectionTitleZh    String?
  homeSolutionSectionTitleEn    String?
  homeSolutionSectionSubtitleZh String?
  homeSolutionSectionSubtitleEn String?
  homeProductImage1      String?
  homeProductImage2      String?
  homeProductImage3      String?
  homeProductImage4      String?
  homeSolutionImage1     String?
  homeSolutionImage2     String?
  homeSolutionImage3     String?
  homeAboutTitleZh       String?
  homeAboutTitleEn       String?
  homeAboutContentZh     String?
  homeAboutContentEn     String?
  homeContactTitleZh     String?
  homeContactTitleEn     String?
  translationStatus      TranslationStatus @default(REVIEWED)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Menu {
  id          String   @id @default(cuid())
  menuKey     String   @unique
  labelZh     String
  labelEn     String
  path        String
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Page {
  id                String            @id @default(cuid())
  pageKey            String            @unique
  slug              String            @unique
  titleZh           String
  titleEn           String
  summaryZh         String?
  summaryEn         String?
  contentZh         String?
  contentEn         String?
  blocks            Json?
  publishStatus     PublishStatus     @default(DRAFT)
  translationStatus TranslationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ProductCategory {
  id                String            @id @default(cuid())
  slug              String            @unique
  nameZh            String
  nameEn            String
  descriptionZh     String?
  descriptionEn     String?
  iconUrl           String?
  tabIconUrl        String?
  sortOrder         Int               @default(0)
  publishStatus     PublishStatus     @default(PUBLISHED)
  translationStatus TranslationStatus @default(REVIEWED)
  products          Product[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Product {
  id                String            @id @default(cuid())
  categoryId        String
  category          ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug              String            @unique
  nameZh            String
  nameEn            String
  summaryZh         String?
  summaryEn         String?
  bannerUrl         String?
  galleryImages     Json?
  sortOrder         Int               @default(0)
  publishStatus     PublishStatus     @default(PUBLISHED)
  translationStatus TranslationStatus @default(REVIEWED)
  sections          ProductSection[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ProductSection {
  id                String            @id @default(cuid())
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sectionType       String
  titleZh           String
  titleEn           String
  descriptionZh     String?
  descriptionEn     String?
  imageUrl          String?
  sortOrder         Int               @default(0)
  translationStatus TranslationStatus @default(REVIEWED)
  items             ProductSectionItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ProductSectionItem {
  id                String            @id @default(cuid())
  sectionId         String
  section           ProductSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  titleZh           String?
  titleEn           String?
  descriptionZh     String
  descriptionEn     String
  iconUrl           String?
  sortOrder         Int               @default(0)
  translationStatus TranslationStatus @default(REVIEWED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Solution {
  id                String            @id @default(cuid())
  slug              String            @unique
  titleZh           String
  titleEn           String
  summaryZh         String?
  summaryEn         String?
  coverUrl          String?
  sortOrder         Int               @default(0)
  publishStatus     PublishStatus     @default(PUBLISHED)
  translationStatus TranslationStatus @default(REVIEWED)
  painPoints        SolutionPainPoint[]
  advantages        SolutionAdvantage[]
  architectures     SolutionArchitectureBlock[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model SolutionPainPoint {
  id                String            @id @default(cuid())
  solutionId        String
  solution          Solution          @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  titleZh           String
  titleEn           String
  descriptionZh     String
  descriptionEn     String
  iconUrl           String?
  sortOrder         Int               @default(0)
  translationStatus TranslationStatus @default(REVIEWED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model SolutionAdvantage {
  id                String            @id @default(cuid())
  solutionId        String
  solution          Solution          @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  titleZh           String
  titleEn           String
  descriptionZh     String
  descriptionEn     String
  iconUrl           String?
  sortOrder         Int               @default(0)
  translationStatus TranslationStatus @default(REVIEWED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model SolutionArchitectureBlock {
  id                String            @id @default(cuid())
  solutionId        String
  solution          Solution          @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  titleZh           String
  titleEn           String
  imageUrl          String?
  descriptionZh     String?
  descriptionEn     String?
  sortOrder         Int               @default(0)
  translationStatus TranslationStatus @default(REVIEWED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model NewsPost {
  id                String            @id @default(cuid())
  slug              String            @unique
  titleZh           String
  titleEn           String
  summaryZh         String?
  summaryEn         String?
  contentZh         String
  contentEn         String
  coverUrl          String?
  publishStatus     PublishStatus     @default(PUBLISHED)
  publishedAt       DateTime?
  sortOrder         Int               @default(0)
  translationStatus TranslationStatus @default(REVIEWED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  fileName    String
  originalName String
  mimeType    String
  size        Int
  path        String
  url         String
  altZh       String?
  altEn       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model SeoMeta {
  id          String   @id @default(cuid())
  pageKey     String
  locale      String
  title       String
  description String?
  keywords    String?
  ogImageUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pageKey, locale])
}
